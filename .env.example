# ---------- Application ----------
APP_NAME=RAG Knowledge Base
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- Ollama ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:latest
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT=600
# Thinking models (qwen3) emit reasoning traces; keep disabled for faster, cleaner answers.
OLLAMA_THINK=false
# Keeps the model resident between questions instead of reloading it every time.
OLLAMA_KEEP_ALIVE=30m

# ---------- Embeddings ----------
# Generation and embeddings may live on different Ollama hosts: put the LLM wherever
# the GPU is, and keep embeddings on the host whose model produced the vectors already
# stored in Qdrant. Leave empty to use OLLAMA_BASE_URL for both.
EMBEDDING_BASE_URL=
# bge-m3 is multilingual (Arabic + English) and produces 1024-dimension vectors.
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=300
EMBEDDING_KEEP_ALIVE=30m

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base
QDRANT_API_KEY=
QDRANT_TIMEOUT=60

# ---------- Retrieval ----------
# TOP_K applies to focused questions; WIDE_TOP_K to questions that span sections.
TOP_K=8
WIDE_TOP_K=14
# How many candidates each retrieval arm contributes before reranking.
CANDIDATE_POOL=30
SCORE_THRESHOLD=0.35
# Vector hits below this are never considered; the reranker decides the rest.
VECTOR_SCORE_FLOOR=0.25
# A reranked candidate below this is treated as irrelevant.
MIN_RERANK_SCORE=0.15
# Slots kept for the closest semantic matches so lexical scoring cannot bury them —
# this is what keeps an English answer reachable from an Arabic question.
RESERVED_SEMANTIC_SLOTS=3
MAX_EXPANDED_CANDIDATES=60
PRIMARY_EVIDENCE_COUNT=3
# Context size drives latency: prefill runs at ~58 tokens/s here and Arabic averages
# 2.24 chars per token, so every 1000 chars of context costs roughly 7.7 seconds.
# Focused questions get the narrow budget; only section-spanning questions pay for more.
MAX_CONTEXT_CHARS=12000
NARROW_CONTEXT_CHARS=7000
MAX_RELATED_BLOCKS=3
# A retry costs a second generation; retrieval-side gap filling runs before the first one.
ANSWER_RETRY_ON_INCOMPLETE=false
RETRY_TOP_K=18

# ---------- Hybrid retrieval switches ----------
ENABLE_KEYWORD_SEARCH=true
ENABLE_ENTITY_RETRIEVAL=true
ENABLE_EXPANSION=true

# ---------- Chunking ----------
CHUNK_SIZE=1400
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=200
MAX_HEADING_DEPTH=4

# ---------- Ingestion ----------
ALLOWED_EXTENSIONS=.md,.markdown
MAX_UPLOAD_BYTES=20971520
INGESTION_WORKERS=2
DEFAULT_CATEGORY=General

# ---------- Web client ----------
# Origins allowed to call the API from a browser. The production build is served by this
# app, so it is same-origin and needs no entry here; these are for `npm run dev`. Set it
# to the client's origin only if you deploy the interface separately.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Built client. When this directory has an index.html the app serves the single-page
# interface from it; otherwise it falls back to the legacy static page.
WEB_DIST_DIR=web/dist

# ---------- Knowledge layer ----------
# false isolates the taught-knowledge arm completely: no query, no prompt change.
# The gold set is run both ways, so this is what proves the arm is neutral rather
# than merely believed to be.
ENABLE_KNOWLEDGE_LAYER=true
# A collection of its own: taught claims never compete with document passages in
# one vector ranking.
QDRANT_KNOWLEDGE_COLLECTION=knowledge_items
# Below this a semantic hit is noise. Without a floor every item resembles every
# question a little, and the whole knowledge base attaches to each answer.
KNOWLEDGE_SCORE_THRESHOLD=0.45

# ---------- Authentication ----------
# Sessions are server-side rows keyed by a cookie, so revoking one takes effect at once.
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=rag_session
# Set true once this is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Read once by `python -m app.cli bootstrap`, which creates the first administrator and
# the read-only service account. Clear them afterwards; they are not used again.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# The evaluation harness and the test suites sign in as this account. It carries only
# chat.ask, document.read and system.read — it cannot upload, delete or manage users.
SERVICE_ACCOUNT_EMAIL=service@local
SERVICE_ACCOUNT_PASSWORD=

# ---------- ERP integration (machine-to-machine API) ----------
# Off unless an operator turns it on. A machine-callable surface that appears the moment
# the code is deployed is a surface nobody decided to expose.
INTEGRATION_ENABLED=false
# Root of every integration credential. Never stored in the database; without it no
# credential can be minted or verified. Generate one with:
#   python -m app.cli integration-master-key
INTEGRATION_MASTER_KEY=
# Keep this on in production. A request body carries supplier prices and purchase
# figures, and a signature proves the body was not altered — it does not conceal it.
INTEGRATION_REQUIRE_HTTPS=true
INTEGRATION_TIMESTAMP_SKEW_SECONDS=300
INTEGRATION_NONCE_TTL_SECONDS=600
# The endpoint's own budget, well under a caller's read timeout so the reply is an
# orderly 408 rather than a dropped connection.
INTEGRATION_ANSWER_BUDGET_SECONDS=90
# Starting values. One model instance answers both this API and the people using the
# web interface, so these are sized from measured throughput, not from a round number.
INTEGRATION_RATE_LIMIT_PER_MINUTE=6
INTEGRATION_RATE_LIMIT_BURST=10
INTEGRATION_MAX_CONCURRENCY=2
INTEGRATION_QUEUE_DEPTH=4
INTEGRATION_DAILY_QUOTA=500
INTEGRATION_IDEMPOTENCY_TTL_HOURS=24
INTEGRATION_MAX_BODY_BYTES=65536
# ---------- Reranking ----------
# feature = countable signals only (default). cross = adds a local cross-encoder on top
# and falls back to feature if the model is missing. Measured on a 6-core laptop CPU it
# added 7–18 s per question for a 2–4 % gain in section rank and no gain in evidence
# recall, so it is off by default. Install with requirements-reranker.txt and
# scripts/download_reranker.py.
RERANKER=feature
RERANKER_MODEL_DIR=models/reranker
RERANKER_WEIGHT=2.0
RERANKER_TOP_N=12
RERANKER_MAX_TOKENS=256
RERANKER_THREADS=0
RERANKER_BUDGET_MS=15000

# ---------- Backups (scripts/backup.py, scripts/install-maintenance-tasks.ps1) ----------
BACKUP_DIR=backups
# A second disk or an internal share. Without it the backup is on the same disk as the
# data and does not survive that disk.
BACKUP_MIRROR_DIR=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Includes .env in each archive for INTEGRATION_MASTER_KEY, without which every issued
# ERP credential is lost. The archives then hold secrets; store them accordingly.
BACKUP_INCLUDE_ENV=true
BACKUP_MAX_AGE_HOURS=26

# ---------- Monitoring (/admin/monitoring, /api/metrics) ----------
MONITOR_P95_MS=240000
MONITOR_ERROR_RATE=0.05
MONITOR_REFUSAL_RATE=0.40
# Lets a monitoring system scrape /api/metrics with "Authorization: Bearer <token>".
# Unset, the endpoint needs a signed-in administrator.
METRICS_TOKEN=
