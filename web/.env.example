# Absolute origin of the API.
#
# Leave this empty for production: the built client is served by the FastAPI app itself,
# so every request is same-origin and needs no configured host. Set it only when the
# client is deployed somewhere other than the API — and then add that origin to
# CORS_ORIGINS in the backend's .env, or the browser will block the requests.
VITE_API_BASE_URL=

# Where `npm run dev` proxies /api during development. The dev server runs on :5173 and
# the API on :8000, so the proxy keeps the browser talking to one origin.
VITE_DEV_API=http://127.0.0.1:8000
